# FeexPay — identifiants MARCHANDS (côté SERVEUR uniquement).
# Ces valeurs sont lues par les fonctions serverless dans /api/feexpay/*.
# NE PAS préfixer par VITE_ : la clé ne doit jamais atteindre le navigateur.
#
# En production : Vercel → projet afa → Settings → Environment Variables
# (environnement Production, puis Redeploy).

# Clé API FeexPay (Bearer) — SECRÈTE (peut aussi initier des payouts).
# Le code accepte aussi le nom FEEXPAY_TOKEN si vous préférez.
FEEXPAY_API_KEY=

# Identifiant de votre boutique FeexPay (Shop ID).
FEEXPAY_SHOP_ID=

# Back-office accréditations — compte de démonstration.
# Si ces variables sont absentes, le serveur utilise :
#   e-mail    gauthier.ore@africafashionawards.com
#   mot de passe  Audace2026
# À remplacer en production. ADMIN_SESSION_SECRET signe le cookie de session.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Persistance des demandes (optionnelle). Sans ces variables, le serveur
# écrit data/accreditations.json (ou /tmp sur un système de fichiers en lecture seule).
# En production Vercel, brancher un Blob privé ou un Redis REST (Vercel KV / Upstash) :
# BLOB_READ_WRITE_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
