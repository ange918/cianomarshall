# FeexPay — identifiants marchands (https://feexpay.me → tableau de bord)
# Copiez ce fichier en `.env` puis renseignez vos valeurs.
# En production (Vercel) : Settings → Environment Variables.

# Identifiant de votre boutique FeexPay (Shop ID)
VITE_FEEXPAY_SHOP_ID=

# Clé API / token FeexPay
VITE_FEEXPAY_TOKEN=

# Mode : SANDBOX (tests) ou LIVE (encaissement réel)
VITE_FEEXPAY_MODE=SANDBOX
