# FeexPay — identifiants MARCHANDS (côté SERVEUR uniquement).
# Ces valeurs sont lues par les fonctions serverless dans /api/feexpay/*.
# NE PAS préfixer par VITE_ : la clé ne doit jamais atteindre le navigateur.
#
# En production : Vercel → projet afa → Settings → Environment Variables
# (environnement Production, puis Redeploy).

# Clé API FeexPay (Bearer) — SECRÈTE (peut aussi initier des payouts).
# Le code accepte aussi le nom FEEXPAY_TOKEN si vous préférez.
FEEXPAY_API_KEY=

# Identifiant de votre boutique FeexPay (Shop ID).
FEEXPAY_SHOP_ID=

# Back-office accréditations. Les trois variables sont obligatoires.
# Sans elles, /admin affiche « back-office non configuré » et refuse la connexion.
# Aucun mot de passe n’est codé dans le dépôt. ADMIN_NAME est optionnel (défaut : Administrateur).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_NAME=

# WhatsApp — notification au numéro saisi sur la demande (Approuver, Complément, Refuser).
# Sans fournisseur, la décision est quand même enregistrée et l’admin voit un avertissement.
# Un seul fournisseur suffit. Si les deux sont remplis, Twilio est utilisé,
# sauf si WHATSAPP_PROVIDER=meta (ou twilio).
#
# Twilio WhatsApp :
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
#
# Meta WhatsApp Cloud API :
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_PHONE_ID=
# META_WHATSAPP_API_VERSION=v21.0
#
# WHATSAPP_PROVIDER=
# Lien absolu du suivi public (défaut : URL Vercel, sinon https://cianomarshall.vercel.app)
# PUBLIC_SITE_URL=

# Persistance des demandes. Sans ces variables, le serveur
# écrit data/accreditations.json (ou /tmp sur un système de fichiers en lecture seule).
# En production Vercel, brancher un Blob privé ou un Redis REST (Vercel KV / Upstash) :
# BLOB_READ_WRITE_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
